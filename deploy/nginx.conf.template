# edge 컨테이너 설정 (nginx 공식 이미지가 시작할 때 ${SITE_...}만 envsubst 로 채운다 — NGINX_ENVSUBST_FILTER=^SITE_).
# 서버 nginx(TLS, <도메인>.java21.net) → 127.0.0.1:<APP_PORT> → 여기(80)
#   /blog/  → minio:9000  (사진 공개 주소·업로드 서명 주소. 버킷 이름 = 경로. 화면 라우트와 겹치지 않는다: "blog"는 예약 handle)
#   그 밖   → 지금 켜진 앱 (app-blue:8080 또는 app-green:8080 — /etc/nginx/active/upstream.conf, deploy.sh가 바꾸고 reload)
# Host·X-Forwarded-For는 앞단 서버 nginx가 보낸 값을 그대로 넘긴다.
#   - Host: 업로드 서명(SigV4)이 Host까지 서명하므로 브라우저가 본 도메인이어야 한다. 앞단이 Host를 안 넘겨
#     localhost:<포트>가 오면 SITE_HOST로 바꿔 끼운다(앞단 설정 실수 대비)
#   - X-Forwarded-For: 앞단 값 뒤에 앞단 주소를 덧붙인다(앱은 신뢰 프록시 대역을 빼고 가장 오른쪽 주소를 쓴다)
#   - X-Forwarded-Proto: 항상 SITE_URL의 스킴. 브라우저 → 클라우드플레어(https) → 서버 nginx(80)로 오면
#     서버 nginx는 $scheme=http를 보내서, 그대로 넘기면 앱이 구글·깃허브 로그인 주소를 http로 만든다

# http로 들어온 손님은 https로 보낸다. 클라우드플레어가 브라우저가 쓴 스킴을 CF-Visitor({"scheme":"http"})로 알려 준다.
# (서버 nginx의 X-Forwarded-Proto는 늘 http라 쓸 수 없다.) CF-Visitor가 없는 요청 — deploy.sh의 상태 확인, 서버 안에서
# 직접 부르는 curl — 은 그대로 둔다. SITE_SCHEME이 https일 때만(로컬 http 운영이면 넘기지 않는다)
map "$http_cf_visitor|${SITE_SCHEME}" $edge_to_https {
    default                          0;
    "~\"scheme\":\"http\"\}\|https$"  1;
}

map $http_host $edge_host {
    default                                  $http_host;
    ""                                       ${SITE_HOST};
    "~^(localhost|127\.0\.0\.1)(:[0-9]+)?$"  ${SITE_HOST};
}

server {
    listen 80 default_server;
    server_name _;
    server_tokens off;

    # 사진 원본·첨부파일 10MB(blog.image.max-upload-bytes·blog.attachment.max-bytes) + 여유. 서버 nginx에도 같은 값 이상이 필요하다 (README).
    # 첨부파일은 /api/posts/{id}/attachments 로 앱이 받아 저장소(attachments/*, 익명 읽기 없음)에 넣는다
    client_max_body_size 12m;

    # 주소는 SITE_HOST로 고정한다(손님이 보낸 Host로 다른 곳에 보내지 않게)
    if ($edge_to_https) {
        return 301 https://${SITE_HOST}$request_uri;
    }

    proxy_http_version 1.1;
    proxy_set_header Host $edge_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto ${SITE_SCHEME};
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Connection "";

    # 앱·minio 컨테이너가 다시 만들어지면 내부 주소가 바뀐다. 시작할 때 한 번만 찾지 않도록
    # 도커 내부 DNS(127.0.0.11)로 10초마다 다시 찾는다 (변수로 쓴 proxy_pass만 다시 찾는다)
    resolver 127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 5s;
    set $minio_upstream minio:9000;
    # 무중단 배포: 보낼 앱 색은 deploy.sh가 이 파일에 적고 nginx -s reload 한다 (진행 중인 요청은 끊지 않는다)
    include /etc/nginx/active/upstream.conf;

    location /blog/ {
        # 브라우저가 쓰는 것만: 공개 사진 읽기(GET·HEAD), 서명 주소 업로드(PUT), CORS 사전 요청(OPTIONS).
        # 지우기·목록은 앱이 compose 안 주소(http://minio:9000)로 직접 한다
        limit_except GET PUT OPTIONS {
            deny all;
        }
        proxy_pass http://$minio_upstream;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 60s;
    }

    location / {
        proxy_pass http://$app_upstream;
        proxy_read_timeout 60s;
    }
}
